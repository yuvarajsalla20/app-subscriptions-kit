{
  "name": "app-subscriptions-kit",
  "version": "11.2.0",
  "description": "Reusable subscription pattern for React Native / Expo apps: one config for tiers, features and limits, canUse/limit checks, a useSubscription hook, and themeable Plans screen, Free vs paid table, lock badges, gate and Settings row. Works with app-payments-kit or any payments object.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./firestore": "./src/firestore.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Yuvaraj Salla",
  "peerDependencies": {
    "app-core-kit": ">=1.12.0",
    "firebase": ">=11",
    "react": ">=18",
    "react-native": ">=0.74",
    "react-native-svg": ">=13"
  },
  "peerDependenciesMeta": {
    "firebase": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "app-core-kit": "git+https://github.com/yuvarajsalla20/app-core-kit.git#7d930db5a0c61c88fc5157465e524c535a091e0e",
    "firebase": "^11.10.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-svg": "^15.16.0",
    "react-test-renderer": "19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p ."
  }
}
